# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Path to a replacement for morshu.wav. When it is unset or empty, the packaged copy is used.
# This setting has no default value, so the path below is only an example.
# TTS_SOURCE_WAV=/path/to/morshu.wav

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# /tts/synthesize accepts text of at most this many characters.
# TTS_MAX_TEXT_LENGTH=500
